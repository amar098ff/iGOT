# KarmaSiksha Server Environment Variables
# Copy this to .env and fill in your values

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/karmasiksha

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider (choose one: gemini | openai | mock)
AI_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL_GEMINI=gemini-1.5-flash
AI_MODEL_OPENAI=gpt-4o-mini

# File Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=uploads

# iGOT / Karmayogi Integration
IGOT_ENABLED=false
IGOT_API_BASE_URL=https://api.igot.gov.in/api
IGOT_API_KEY=your-igot-api-key-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGIN=http://localhost:5173

# Client URL (for password reset links etc.)
CLIENT_URL=http://localhost:5173
